/*  ******************** Physical configuration of the coders: board with the 4051 multiplexers ********************

    One line per position of the multiplexers, in the order of the scan (position 0 first):
        CODER(coder, touch, type, sw, dir)
    coder : logical number of the coder read at this position (index of the coder values and of codersSw)
    touch : logical number of the touch button read at this position
    type  : CT_FULL  blue coders, bare: one full cycle of CK and DT per detent, rest at 11
            CT_HALF  green coders, bare or on modules: half a cycle per detent, rest at 11 and 00
            CT_NONE  no coder at this position: not decoded, its touch button is still read
    sw    : SW_HIGH  pressing the switch gives a high level (switch to 3.3 V, SW pulled down)
            SW_LOW   pressing the switch gives a low level (switch to ground, SW pulled up: modules)
    dir   : DIR_NORM CK falls first when turning clockwise: the value goes up
            DIR_REV  CK and DT swapped in the wiring: the direction is reversed
    Types, switches and directions can be mixed freely. The number of lines must be CODER_NB.
    The wiring of this board is out of order: the coder and touch numbers are not those of the positions.

    *****************************************************************************************************************/

#if CODER_NB != 8
#error "this table describes 8 positions: CODER_NB must be 8"
#endif

CODER( 6,  0, CT_HALF, SW_LOW, DIR_NORM)        // position 0
CODER( 7,  1, CT_HALF, SW_LOW, DIR_NORM)
CODER( 0,  4, CT_HALF, SW_LOW, DIR_NORM)
CODER( 1,  3, CT_HALF, SW_LOW, DIR_NORM)
CODER( 2,  2, CT_HALF, SW_LOW, DIR_NORM)
CODER( 5,  5, CT_HALF, SW_LOW, DIR_NORM)
CODER( 4,  6, CT_HALF, SW_LOW, DIR_NORM)
CODER( 3,  7, CT_HALF, SW_LOW, DIR_NORM)        // position 7
