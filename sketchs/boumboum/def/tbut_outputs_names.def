/* outputs names for touch_buttons */

    X(TOUCH_BUTTON_GATE,"TB_V")
    X(TOUCH_BUTTON_RISE,"TB_R")
    X(TOUCH_BUTTON_FALL,"TB_F")
    X(TOUCH_BUTTON_P_R_,"TBPR")
    X(TOUCH_BUTTON_P_F_,"TBFF")

