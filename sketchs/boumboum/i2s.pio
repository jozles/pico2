.program i2s

.side_set 2

.wrap_target

left_chan:
    set x, 31		 side 0b00 [0]

bitloop_left:
    out pins, 1       	 side 0b00 [4]  ; BCLK=0, LRCLK=0
    jmp x-- bitloop_left side 0b01 [4]  ; BCLK=1, LRCLK=0
    jmp right_chan       side 0b01 [0]

right_chan:
    set x, 31		  side 0b10 [0]

bitloop_right:
    out pins, 1           side 0b10 [4]  ; BCLK=0, LRCLK=1
    jmp x-- bitloop_right side 0b11 [4]  ; BCLK=1, LRCLK=1
    jmp left_chan         side 0b11 [0]
.wrap

; (31*10+1*12)*2=644
; clkdiv=150000/44.1/644=5.2816
; sm_config_set_clkdiv(&c, 5.2816f);


